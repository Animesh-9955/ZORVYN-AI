# ZORVYN AI — Server Environment Configuration Template

# Server Port & Environment
PORT=5001
NODE_ENV=development

# Allowed CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=60

# Google Gemini API Configuration (Official @google/genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
# Neon PostgreSQL connection (replace with your Neon connection string)
DATABASE_URL=postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DB_NAME>?sslmode=require
GEMINI_MODEL=gemini-3.8-flash
